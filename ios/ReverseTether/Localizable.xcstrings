    },
    "error_no_network" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Cellular or Wi-Fi first (you don't need to join a network), then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先打开蜂窝或 Wi-Fi（不用连上网络），然后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先打開行動網路或 Wi-Fi（不用連上網路），然後再試。"
          }
        }
      }
    },
